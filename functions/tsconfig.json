{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true,
    "paths": {
      "@mi-app/types": ["./../packages/shared-types/index.d.ts"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
