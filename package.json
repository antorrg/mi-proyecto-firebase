{
  "name": "proyecto-mayorista-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:publica": "npm --workspace=publica run dev",
    "dev:admin": "npm --workspace=admin run dev",
    "build:publica": "npm --workspace=publica run build",
    "build:admin": "npm --workspace=admin run build",
    "build:functions": "npm --prefix functions run build",
    "build": "npm run build:publica && npm run build:admin && npm run build:functions"
  }
}